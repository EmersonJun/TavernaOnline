# Copie para .env e ajuste os valores. O arquivo .env não é versionado.

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tavernaonline
DB_NAME_TEST=tavernaonline_test
DB_USER=taverna
DB_PASSWORD=taverna

# Gere com: openssl rand -base64 64
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRATION_MINUTES=120
